{
  "paper_claims": [
    {
      "id": "C1",
      "claim": "MAX anomaly: high-MAX stocks underperform low-MAX stocks; the value-weighted D10-D1 spread is significantly negative across standard risk factor models (CAPM/FF3/FFC4/FFCPS/FF5/FF6/FF6PS) but becomes insignificant under the SY mispricing and DHS behavioral models.",
      "paper_location": "L273",
      "headline": true
    },
    {
      "id": "C2",
      "claim": "MAX^β anomaly: after beta-neutralization, the high-MAX^β portfolio still underperforms significantly across risk and mispricing factor models, including SY and DHS — the beta-neutralization removes the systematic component and isolates the idiosyncratic lottery effect.",
      "paper_location": "L450-462",
      "headline": true
    },
    {
      "id": "C3",
      "claim": "MAX-sorted portfolios exhibit a strong cross-sectional relation between MAX and characteristics of mispricing/issuance: market beta, MIS, CE, IVOL, REV, ILLIQ all increase with MAX while SIZE and INST decrease.",
      "paper_location": "L299-313"
    }
  ],
  "budget_flag": "Replication targets only the 3 main tables (Table 1, Table 2, Table 6) at the column-level coverage that is feasible with the factor set available in ClickHouse (FF3, FFC4, FF5, FF6 only — PS liquidity, SY mispricing, and DHS behavioral factor columns are SKIP because the required factor series are absent from the catalog). Tables 3-13 and A1-A13 are SKIP because they depend on those same factors (FF6PS, SY, DHS), on the institutional-holdings (13F) quarterly merge, on the SY 11-component mispricing index construction, on the BW sentiment index, or on MAX^β institutional-tier cross-tabs that compound multiple unavailable inputs.",
  "tables": [
    {
      "id": "T1",
      "table_ref": "Table 1",
      "description": "Univariate decile sorts on MAX — value-weighted excess returns and factor-model alphas",
      "replication_meaning": "Demonstrates correct (i) MAX computation (avg of 5 highest daily returns per month, min 15 obs), (ii) monthly decile sort on MAX with value-weighting using CRSP market equity (lagged to avoid same-month look-ahead), (iii) next-month value-weighted excess-return computation against the FF risk-free rate, and (iv) factor-model alpha regressions using the FF monthly factor returns available in ClickHouse (FF3, FFC4, FF5, FF6) with Newey-West 6-lag HAC t-stats. Downstream claim C1 (MAX anomaly existence/sign/magnitude) depends on this construction being correct.",
      "covers_claims": ["C1"],
      "paper_quote": "Univariate sorts on MAX: This table reports the performance of decile portfolios constructed monthly by sorting stocks based on MAX, defined as the average of the five highest daily returns within a month. The reported values are value-weighted average one-month-ahead excess returns (RET – RF), as well as alphas from risk-adjusted models (CAPM, FF3, FFC4, FFCPS, FF5, FF6, and FF6PS) and mispricing-adjusted models (SY and DHS). Newey and West (1987) t-statistics (adjusted with six lags) are reported in parentheses. The sample period spans January 1968 to December 2022.",
      "exercises_preprocessing_rules": ["universe_share_codes", "universe_exchanges", "universe_exclude_utility", "universe_exclude_financial", "universe_price_floor", "avail_min_15_obs_per_month", "sample_period_main", "var_max_definition", "sort_decile_max", "sort_vw_weighting", "sort_rebalance_monthly", "sort_excess_returns", "factor_ff_set", "factor_nw_lags", "var_size"],
