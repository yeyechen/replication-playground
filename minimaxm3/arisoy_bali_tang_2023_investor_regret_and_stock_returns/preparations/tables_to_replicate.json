{
  "paper_claims": [
    {
      "id": "C1",
      "claim": "High-REG stocks (high investor regret) earn significantly higher next-month returns than low-REG stocks. The 5-1 value-weighted spread is 0.40% per month (t=3.66) over 1963-2020.",
      "paper_location": "L49-50",
      "headline": true
    },
    {
      "id": "C2",
      "claim": "The REG alpha spread remains positive and significant across nine factor models (CAPM, FF3, FFC, FFCPS, FF5, FF6, FF6PS, Q, Q+), ranging from 0.29% to 0.61% per month with t-stats 2.59-6.52.",
      "paper_location": "L232",
      "headline": true
    },
    {
      "id": "C3",
      "claim": "The REG premium survives dependent bivariate sorts controlling for 12 stock characteristics (BETA, SIZE, BM, MOM, STR, COSKEW, ILLIQ, IVOL, MAX, OP, IA, SUE); the FF6PS alpha spread ranges from 0.51% to 0.84% per month with t-stats 5.40-9.53.",
      "paper_location": "L276"
    },
    {
      "id": "C4",
      "claim": "REG remains a significant predictor in Fama-MacBeth cross-sectional regressions after controlling for 12 firm characteristics; the average slope ranges from 0.011 (no controls, t=6.44) to 0.006 (full controls, t=5.13).",
      "paper_location": "L317-319"
    },
    {
      "id": "C5",
      "claim": "The REG premium is stronger for illiquid, small, and young stocks \u2014 consistent with costly arbitrage and informational frictions. The 5-1 FF6PS alpha spread for illiquid stocks is 1.06%/month (t=8.78) vs 0.61% for liquid stocks (t=4.85).",
      "paper_location": "L571"
    }
  ],
  "budget_flag": null,
